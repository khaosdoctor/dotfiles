#!/usr/bin/env bash
# Masks secrets in stdin. Used by redact-proc-guard to keep tokens out of transcripts.
# Regex-based, so best effort: unusual formats can still slip through.
exec sed -E \
  -e 's/\b(Bearer|Basic|Token)[[:space:]]+[^[:space:]"'"'"']+/\1 [REDACTED]/Ig' \
  -e 's/\b(CF-Access-Client-(Id|Secret)|Authorization|X-Api-Key|Api-Key|X-Auth-Token)([[:space:]]*[:=][[:space:]]*)[^[:space:]"'"'"']+/\1\3[REDACTED]/Ig' \
  -e 's/(--?[A-Za-z0-9_-]*(pass|passwd|password|token|secret|apikey|api-key|api_key|credential)[A-Za-z0-9_-]*)([ =])[^[:space:]]+/\1\3[REDACTED]/Ig' \
  -e 's/\b([A-Za-z0-9_]*(PASS|PASSWORD|TOKEN|SECRET|API_KEY|APIKEY|ACCESS_KEY|PRIVATE_KEY|CREDENTIAL)[A-Za-z0-9_]*)=[^[:space:]]+/\1=[REDACTED]/Ig' \
  -e 's/\b(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|ops_[A-Za-z0-9_-]{20,})/[REDACTED]/g' \
  -e 's#(://[^/:@[:space:]]+:)[^@/[:space:]]+@#\1[REDACTED]@#g'
