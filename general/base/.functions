#!/bin/zsh
#CUSTOM FUNCTIONS
cd() {
    builtin cd "$@" || return $?
    # eza is not installed everywhere, .aliases guards ls the same way
    if [ -x "$(command -v eza)" ]; then
        eza --icons --color=auto -a
    fi
}

cat() {
  # Checks which text renderer to use depending on the installed programs
  local text_cat
  if command -v bat >/dev/null 2>&1; then
      text_cat=(bat --paging=never)
  else
    text_cat=(/usr/bin/cat)
  fi

  # If it's not a TTY behaves like CAT
  if [[ ! -t 0 ]]; then
    command "${text_cat[@]}" "$@"
    return
  fi

  # If we have kitty then icat is available
  local has_kitty=false
  [[ -n "$KITTY_WINDOW_ID" ]] && has_kitty=true

  # If there are any flags present defer to the text renderer
  # if any arg is not a regular file, also defer to the renderer
  for arg in "$@"; do
    if [[ "$arg" == -* ]] || [[ ! -f "$arg" ]]; then
      command "${text_cat[@]}" "$@"
      return $?
    fi
  done

  # Checks if any of the files is an image, if so, uses icat if in kitty
  for file in "$@"; do
    local mime
    mime=$(file --mime-type -b "$file")

    if $has_kitty && [[ "$mime" == image/* ]]; then
      kitten icat "$file"
    else
      command "${text_cat[@]}" "$file"
    fi
  done
}

git_goto() {
    find . -name .git -type d -execdir git checkout "$1" ";"
}

mkcd() {
    mkdir -p "$1" && cd "$1" || return
}

whichport() {
    sudo lsof -i -n -P | grep :$1
}

# requires yazi, allows to return to the last yazi folder when exiting
function yy() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd" || return
    fi
    rm -f -- "$tmp"
}

# Remote hosts rarely have terminfo entries for xterm-ghostty/xterm-kitty, which
# breaks the remote session, so downgrade TERM for the remote side only.
ssh() {
    TERM=xterm-256color command ssh "$@"
}

function systemLog() {
    local input

    if [ ! -t 0 ]; then
        input=$(cat)
    else
        input=$1
    fi

    # on mac log to console
    if [[ "$(uname -s)" == "Darwin" ]]; then
        if [ -x "$(command -v logger)" ]; then
            logger -t "${2:-'UserLogger'}" "[UserTerminalLogger] $input" &
        else
            echo "[${2:-"INFO"}] $input" >>/var/log/user_terminal.log
        fi
    # Linux with systemd log to journal
    elif [[ "$(uname -s)" == "Linux" ]]; then
        if [ -x "$(command -v systemd-cat)" ]; then
            command -v systemd-cat && (echo "$1" | systemd-cat -t "${2:-"info"}") &
        else
            echo "[${2:-"INFO"}] $input" >>/var/log/user_terminal.log
        fi
    # default to log to file
    else
        echo "[${2:-"INFO"}] $input" >>/var/log/user_terminal.log
    fi
}

if [ -x "$(command -v brew)" ]; then
    # ~/Brewfile is a symlink into the dotfiles repo, so the dump goes to a temp
    # file first and only its bytes are copied over the symlink. A redirect
    # straight onto ~/Brewfile truncates the tracked file the moment the command
    # starts, which loses the whole thing if the dump fails or is interrupted
    # (a cold Homebrew API cache can make it hang for minutes).
    brewfileDump() {
        local tmp
        tmp=$(mktemp) || return 1
        if command brew bundle dump -f --file="$tmp" && [ -s "$tmp" ]; then
            cat "$tmp" >"$HOME/Brewfile"
        else
            echo "brew bundle dump failed — Brewfile left untouched." >&2
            rm -f "$tmp"
            return 1
        fi
        rm -f "$tmp"
    }

    brew() {
        command brew "$@"
        local brewStatus=$?
        local subcommand=$1

        # Only refresh the Brewfile when the command actually succeeded,
        # otherwise a typo'd package name rewrites the file for nothing.
        if [ $brewStatus -ne 0 ]; then
            return $brewStatus
        fi

        # remove/rm are aliases of uninstall, and taps are recorded in the
        # Brewfile too, so they all have to trigger a refresh.
        case "$subcommand" in
        install | uninstall | remove | rm | tap | untap)
            echo "Detected $subcommand command, updating Brewfile... Don't forget to commit the changes!"
            shift
            systemLog "Updating brewfile after $subcommand command with options: $*"
            brewfileDump
            ;;
        esac

        # Always hand back brew's own status, never the dump's, so `brew install
        # x && ...` branches on the install.
        return $brewStatus
    }
fi

# rm goes to the XDG trash instead of unlinking. trash-put swallows rm's
# flags (-r/-f/-i/-v/-d) as no-ops, so muscle memory and `rm -rf` still work.
# Escape hatch for a real unlink: `command rm`, `\rm`, or /usr/bin/rm.
if [ -x "$(command -v trash-put)" ]; then
    rm() {
        trash-put "$@"
    }
fi

# Claude Code against the OpenCode Go gateway. The key comes from opencode's
# own auth store, the model catalog is fetched live (cached for offline runs)
# and injected into the /model picker via --settings, so no Claude config
# file is touched. behavesAs maps the Go ids onto a catalog model, which
# silences the unrecognized_model warning. Pass a model id to preselect it:
# `openclaude qwen3.8-max`. Default is the free space-bunny-free.
openclaude() {
    local auth="$HOME/.local/share/opencode/auth.json"
    local base="https://opencode.ai/zen/go"
    local cache="$HOME/.cache/opencode-go-models.json"
    local key

    key=$(jq -r '."opencode-go".key // empty' "$auth" 2>/dev/null)
    if [[ -z "$key" ]]; then
        echo "openclaude: no opencode-go key in $auth, run /connect in opencode first" >&2
        return 1
    fi

    mkdir -p "${cache:h}"
    if curl -fsS -H "Authorization: Bearer $key" "$base/v1/models" -o "$cache.new" 2>/dev/null; then
        mv "$cache.new" "$cache"
    else
        rm -f "$cache.new"
        if [[ ! -f "$cache" ]]; then
            echo "openclaude: model list fetch failed and no cache at $cache" >&2
            return 1
        fi
        echo "openclaude: using cached model list" >&2
    fi

    # Only a non-flag first arg is a model, so `openclaude -p "..."` passes
    # the flag through to claude instead of treating it as a model id.
    local model="space-bunny-free"
    if [[ $# -gt 0 && "$1" != -* ]]; then
        model="$1"
        shift
    fi

    local settings
    settings=$(jq -n \
        --arg base "$base" \
        --arg key "$key" \
        --slurpfile models "$cache" \
        '{
            env: {
                ANTHROPIC_BASE_URL: $base,
                ANTHROPIC_API_KEY: $key
            },
            modelPicker: {
                options: ($models[0].data | map({model: .id, label: .id, behavesAs: "claude-sonnet-4-5"}))
            }
        }')

    command claude --model "$model" --settings "$settings" "$@"
}
