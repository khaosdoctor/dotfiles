; ── Weather widget ────────────────────────────────────────
; Poll frequency: change "900s" below to adjust (e.g. "300s" for 5 min)

(defpoll weather-icon     :interval "900s" `~/.config/eww/scripts/weather.sh icon`)
(defpoll weather-temp     :interval "900s" `~/.config/eww/scripts/weather.sh temp`)
(defpoll weather-min      :interval "900s" `~/.config/eww/scripts/weather.sh min`)
(defpoll weather-max      :interval "900s" `~/.config/eww/scripts/weather.sh max`)
(defpoll weather-feels    :interval "900s" `~/.config/eww/scripts/weather.sh feels`)
(defpoll weather-humidity :interval "900s" `~/.config/eww/scripts/weather.sh humidity`)
(defpoll weather-wind     :interval "900s" `~/.config/eww/scripts/weather.sh wind`)
(defpoll weather-desc     :interval "900s" `~/.config/eww/scripts/weather.sh desc`)
(defpoll weather-color    :interval "900s" `~/.config/eww/scripts/weather.sh color`)
(defpoll weather-hicon   :interval "900s" `~/.config/eww/scripts/weather.sh humidity-icon`)

(defwidget weather-inline []
  (box
    :class "weather"
    :orientation "h"
    :space-evenly false
    :halign "center"
    :spacing 12
    :valign "center"
    (box
      :orientation "v"
      :space-evenly false
      (box :height 54
        (label
          :class "weather-icon"
          :valign "end"
          :text weather-icon))
      (label
        :class "weather-desc"
        :text weather-desc))
    (box
      :orientation "v"
      :space-evenly false
      (box :height 54
        (label
          :class "weather-temp weather-${weather-color}"
          :valign "end"
          :text weather-temp))
      (label
        :class "weather-feels"
        :text {"feels ${weather-feels}"}))
    (box
      :orientation "v"
      :space-evenly false
      :spacing 4
      :valign "end"
      (box
        :class "weather-pill"
        :orientation "h"
        :space-evenly false
        :spacing 6
        (label
          :class "weather-pill-cold"
          :text {"❄️ ${weather-min}"})
        (label
          :text "/")
        (label
          :class "weather-pill-hot"
          :text {"🔥 ${weather-max}"}))
      (label
        :class "weather-pill"
        :text {"💧 ${weather-humidity}   |   ${weather-hicon}"})
      (label
        :class "weather-pill"
        :text {"💨 ${weather-wind}"}))))

; ── Clock widget ──────────────────────────────────────────

(defpoll clock-time
  :interval "1s"
  `date '+%H:%M'`)

(defpoll clock-date
  :interval "60s"
  `date '+%A, %d of %B %Y'`)

(defwidget cava-vis []
  (box
    :class "cava-container"
    :orientation "h"
    :space-evenly true
    :halign "center"
    :hexpand true
    :height 28
    (for val in {cava-data ?: "[]"}
      (box
        :class "cava-bar"
        :style "background-color: rgba(${cava-color},${val.o ?: '0.70'});"
        :width 8
        :height {val.v == 0 ? 2 : val.v * 4}
        :valign "end"))))

(defwidget clock []
  (box
    :class "clock-container"
    :orientation "v"
    :space-evenly false
    :hexpand true
    :valign "start"
    (label
      :class "clock-time"
      :halign "center"
      :hexpand true
      :text clock-time)
    (label
      :class "clock-date"
      :halign "center"
      :hexpand true
      :text clock-date)
    (weather-inline)))

(defwindow clock
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry
    :x "0%"
    :y "40px"
    :width "100%"
    :height "600px"
    :anchor "top center")
  (clock))

; ── Cava visualizer ────────────────────────────────────────

(deflisten cava-data
  `~/.config/eww/scripts/cava-eww.sh`)

(defpoll cava-color
  :interval "900s"
  :initial "194,194,197"
  `~/.config/eww/scripts/cava-color.sh`)

; ── Now Playing ───────────────────────────────────────────

(defpoll np-status :interval "2s" :initial "Stopped" `playerctl status 2>/dev/null || echo "Stopped"`)
(defpoll np-title  :interval "2s" `~/.config/eww/scripts/now-playing.sh title`)
(defpoll np-artist :interval "2s" `~/.config/eww/scripts/now-playing.sh artist`)
(defpoll np-album  :interval "2s" `~/.config/eww/scripts/now-playing.sh album`)
(defpoll np-icon   :interval "2s" `~/.config/eww/scripts/now-playing.sh icon`)
(defpoll np-art      :interval "5s"  `~/.config/eww/scripts/now-playing.sh art-path`)
(defpoll np-progress :interval "2s" :initial "0" `~/.config/eww/scripts/now-playing.sh progress`)
(defpoll np-time     :interval "2s" `~/.config/eww/scripts/now-playing.sh time-str`)

(defwidget now-playing []
  (box
    :class "np"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :visible {np-title != ""}
    (box :width 420 :height 21 (cava-vis))
    (box
      :orientation "h"
      :space-evenly false
      :spacing 10
      (box
        :width 48
        :height 48
        :class "np-art-container"
        (image
          :visible {np-art != ""}
          :path {np-art != "" ? np-art : "/home/khaosdoctor/.cache/eww-np-placeholder.png"}
          :image-width 48
          :image-height 48)
        (label
          :visible {np-art == ""}
          :class "np-icon"
          :text np-icon))
      (box
        :orientation "v"
        :space-evenly false
        :valign "center"
        :width 350
        (label
          :class "np-title"
          :halign "start"
          :limit-width 45
          :text np-title)
        (box
          :orientation "h"
          :space-evenly false
          (label
            :class "np-artist"
            :halign "start"
            :limit-width 38
            :text {np-album != "" ? "${np-artist} - ${np-album}" : np-artist})
          (box :hexpand true)
          (label
            :class "np-time"
            :halign "end"
            :text np-time))
        (overlay
          :width 350
          :height 4
          (box :class "np-progress-bg" :width 350 :height 4)
          (box
            :class "np-progress-fill"
            :halign "start"
            :width {round((np-progress ?: 0) * 350 / 100, 0)}
            :height 4))))))

(defwindow now-playing
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry
    :x "0%"
    :y "60px"
    :width "500px"
    :height "200px"
    :anchor "bottom center")
  (now-playing))

; ── System Monitor ────────────────────────────────────────

(defpoll sys-cpu       :interval "3s"  :initial "0" `~/.config/eww/scripts/sysmon.sh cpu`)
(defpoll sys-cpu-temp  :interval "5s"  :initial "0" `~/.config/eww/scripts/sysmon.sh cpu-temp-num`)
(defpoll sys-ram       :interval "5s"  :initial "0" `~/.config/eww/scripts/sysmon.sh ram`)
(defpoll sys-gpu       :interval "3s"  :initial "0" `~/.config/eww/scripts/sysmon.sh gpu`)
(defpoll sys-gpu-temp  :interval "5s"  :initial "0" `~/.config/eww/scripts/sysmon.sh gpu-temp-num`)
(defpoll sys-disk      :interval "30s" :initial "0" `~/.config/eww/scripts/sysmon.sh disk`)
(defpoll sys-net-name  :interval "10s" `~/.config/eww/scripts/sysmon.sh net-name`)
(defpoll sys-net-down  :interval "3s"  `~/.config/eww/scripts/sysmon.sh net-down`)
(defpoll sys-net-up    :interval "3s"  `~/.config/eww/scripts/sysmon.sh net-up`)

(defwidget sysmon-bar [label value ?temp]
  (box
    :class "sysmon-row"
    :orientation "h"
    :space-evenly false
    :spacing 6
    (label
      :class "sysmon-label"
      :width 70
      :halign "start"
      :text label)
    (overlay
      :width 140
      :height 14
      (box
        :class "sysmon-bar-bg"
        :width 140
        :height 14)
      (box
        :class "sysmon-bar-fill"
        :halign "start"
        :width {round((value ?: 0) * 140 / 100, 0)}
        :height 14
        :style {"background-color: ${(value ?: 0) < 30 ? 'rgba(134,239,172,0.7)' : (value ?: 0) < 60 ? 'rgba(253,224,71,0.7)' : (value ?: 0) < 85 ? 'rgba(251,146,60,0.7)' : 'rgba(248,113,113,0.8)'};"})
      (label
        :class "sysmon-bar-text"
        :text {"${value ?: 0}%"}))
    (box
      :visible {temp != ""}
      :width 50
      :height 14
      (overlay
        :width 50
        :height 14
        (box
          :class "sysmon-bar-bg"
          :width 50
          :height 14)
        (box
          :class "sysmon-bar-fill"
          :halign "start"
          :width {round((temp ?: 0) * 50 / 100, 0)}
          :height 14
          :style {"background-color: ${(temp ?: 0) < 50 ? 'rgba(147,197,253,0.7)' : (temp ?: 0) < 70 ? 'rgba(134,239,172,0.7)' : (temp ?: 0) < 85 ? 'rgba(251,146,60,0.7)' : 'rgba(248,113,113,0.8)'};"})
        (label
          :class "sysmon-bar-text"
          :text {"🌡️${temp ?: 0}°"})))))

(defwidget sysmon []
  (box
    :class "sysmon"
    :orientation "v"
    :space-evenly false
    :spacing 6
    :halign "start"
    (sysmon-bar
      :label "🖥️ CPU"
      :value sys-cpu
      :temp sys-cpu-temp)
    (sysmon-bar
      :label "🧠 RAM"
      :value sys-ram)
    (sysmon-bar
      :label "🎮 GPU"
      :value sys-gpu
      :temp sys-gpu-temp)
    (sysmon-bar
      :label "💾 Disk"
      :value sys-disk)
    (box
      :class "sysmon-net"
      :orientation "h"
      :space-evenly false
      :spacing 6
      (label
        :class "sysmon-label"
        :width 70
        :halign "start"
        :text {"🌐 ${sys-net-name}"})
      (label
        :class "sysmon-net-down sysmon-net-pill"
        :text {"↓ ${sys-net-down == '0 KB/s' ? '-' : sys-net-down}"})
      (label
        :class "sysmon-net-up sysmon-net-pill"
        :text {"↑ ${sys-net-up == '0 KB/s' ? '-' : sys-net-up}"}))))

(defwindow sysmon
  :monitor 0
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry
    :x "-45px"
    :y "-20px"
    :width "400px"
    :height "170px"
    :anchor "bottom right")
  (sysmon))
