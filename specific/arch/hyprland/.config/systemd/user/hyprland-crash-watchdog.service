[Unit]
Description=Restore apps after Hyprland restarts from a crash
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=%h/.config/hypr/crash-watchdog.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
